# Neo4j Database Connection
# Connect to a local Docker container or Neo4j Aura cloud instance
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# Server Configuration
PORT=3000

# Optional server-side key for Demo Studio planning
GROQ_API_KEY=

# Crawler Configuration Defaults
DEFAULT_MAX_DEPTH=3
DEFAULT_MAX_STATES=25
DEFAULT_HEADLESS=true

# Benchmark harness (bench/): any OpenAI-compatible LLM server with tool calling
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=local
LLM_REASONING_EFFORT=none
MEMGRAPH_URI=bolt://localhost:7687
