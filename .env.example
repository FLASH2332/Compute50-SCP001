# Copy to .env and fill in your values. Both scripts load .env automatically;
# variables already set in your shell take precedence.

# Groq API key, used by crawl_to_graph.py (section summaries) and demo_agent.py (agent loop).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Groq model for both scripts (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Memgraph runs at bolt://localhost:7687 with no auth; the scripts don't read these yet.
# MEMGRAPH_URI=bolt://localhost:7687
